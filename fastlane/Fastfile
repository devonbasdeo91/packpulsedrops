default_platform(:ios)

require "base64"

def normalized_api_key_content
  key_content = ENV["APP_STORE_CONNECT_API_KEY_KEY"].to_s
  return "" if key_content.strip.empty?
  decoded = begin Base64.strict_decode64(key_content) rescue ArgumentError nil end
  normalized = key_content.include?("BEGIN") ? key_content : (decoded&.include?("BEGIN") ? decoded : key_content)
  normalized.gsub("\\n", "\n")
end

def app_store_connect_api_key_from_env
  key_id = ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"].to_s.strip
  issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"].to_s.strip
  key_content = normalized_api_key_content
  return nil if key_id.empty? || issuer_id.empty? || key_content.strip.empty?
  
  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_content: key_content,
    is_key_content_base64: false
  )
end

platform :ios do
  desc "Compile the iOS app and upload it to TestFlight"
  lane :deploy do
    team_id = ENV["FASTLANE_TEAM_ID"].to_s.strip
    UI.user_error!("Missing FASTLANE_TEAM_ID secret.") if team_id.empty?

    # 1. Authenticate with Apple Store Connect API Keys
    api_key = app_store_connect_api_key_from_env

    # 2. Force Fastlane to create the Bundle ID & App Store profiles over the network first
    produce(
      username: ENV["FASTLANE_USER"],
      app_identifier: "://packpulsedrops.com",
      app_name: "PackPulseDrops",
      team_id: team_id
    ) rescue UI.message("App ID already created or skipping registration.")

    # 3. Compile the app into a deployable .ipa file forcing App Store targets
    build_app(
      scheme: "App",
      project: "ios/App/App.xcodeproj",
      export_method: "app-store",
      export_team_id: team_id,
      xcargs: "DEVELOPMENT_TEAM=#{team_id} -allowProvisioningUpdates CODE_SIGN_STYLE=Automatic"
    )

    # 4. Upload to Apple TestFlight
    upload_to_testflight(
      ipa: "build/app.ipa",
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
    UI.success("Successfully built and uploaded app to TestFlight!")
  end
end
