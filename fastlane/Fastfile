default_platform(:ios)

def require_env!(key)
  value = ENV[key].to_s.strip
  UI.user_error!("Missing #{key}. Configure it in GitHub Actions secrets.") if value.empty?
  value
end

platform :ios do
  desc "Upload IPA to TestFlight with App Store Connect API key (.p8)"
  lane :deploy do
    key_id = require_env!("APP_STORE_CONNECT_API_KEY_KEY_ID")
    issuer_id = require_env!("APP_STORE_CONNECT_API_KEY_ISSUER_ID")
    key_content = require_env!("APP_STORE_CONNECT_API_KEY_KEY").gsub("\\n", "\n")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: false,
      in_house: false
    )

    ipa_path = ENV["IPA_PATH"].to_s.strip
    ipa_path = "build/app.ipa" if ipa_path.empty?
    UI.user_error!("IPA not found at #{ipa_path}") unless File.exist?(ipa_path)

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end
end
