default_platform(:ios)

require "base64"
require "tempfile"
require "fileutils"

def require_env!(key, description)
  value = ENV[key].to_s.strip
  UI.user_error!("Missing #{key} (#{description}). Configure it in GitHub Actions secrets.") if value.empty?
  value
end

def normalized_app_store_connect_api_key_content
  key_content = ENV["APP_STORE_CONNECT_API_KEY_KEY"].to_s
  return "" if key_content.strip.empty?
  
  decoded = begin
    Base64.strict_decode64(key_content)
  rescue ArgumentError
    nil
  end
  
  normalized = if key_content.include?("BEGIN")
    key_content
  elsif decoded&.include?("BEGIN")
    decoded
  else
    key_content
  end
  
  normalized.gsub("\\n", "\n")
end

def app_store_connect_api_key_from_env
  key_id = ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"].to_s.strip
  issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"].to_s.strip
  key_content = normalized_app_store_connect_api_key_content
  
  return nil if key_id.empty? || issuer_id.empty? || key_content.strip.empty?
  
  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_content: key_content,
    is_key_content_base64: false
  )
end

platform :ios do
  desc "Upload a pre-built IPA to App Store Connect / TestFlight"
  lane :deploy do
    workspace_root = ENV["GITHUB_WORKSPACE"].to_s.strip
    workspace_root = Dir.pwd if workspace_root.empty?

    ipa_path = ENV["IPA_PATH"].to_s.strip
    ipa_path = "app.ipa" if ipa_path.empty?
    unless ipa_path.start_with?("/")
      ipa_path = File.expand_path(ipa_path, workspace_root)
    end

    xcode_workspace = ENV["XCODE_WORKSPACE"].to_s.strip
    xcode_project = ENV["XCODE_PROJECT"].to_s.strip
    if xcode_workspace.empty? && xcode_project.empty?
      workspace_candidates = (
        Dir.glob(File.join(workspace_root, "*.xcworkspace")).sort +
        Dir.glob(File.join(workspace_root, "**/*.xcworkspace")).sort
      ).reject { |path| path.include?("/Pods/") }.uniq
      project_candidates = (
        Dir.glob(File.join(workspace_root, "*.xcodeproj")).sort +
        Dir.glob(File.join(workspace_root, "**/*.xcodeproj")).sort
      ).reject { |path| path.include?("/Pods/") }.uniq

      xcode_workspace = workspace_candidates.first.to_s
      xcode_project = project_candidates.first.to_s if xcode_workspace.empty?
    end

    UI.user_error!("No Xcode workspace or project found. Set XCODE_WORKSPACE or XCODE_PROJECT, or commit an .xcworkspace/.xcodeproj to the repository.") if xcode_workspace.empty? && xcode_project.empty?

    scheme = ENV["XCODE_SCHEME"].to_s.strip
    if scheme.empty?
      source = xcode_workspace.empty? ? xcode_project : xcode_workspace
      scheme = File.basename(source, File.extname(source))
    end
    UI.user_error!("No Xcode scheme configured. Set XCODE_SCHEME to the app scheme name.") if scheme.empty?

    FileUtils.mkdir_p(File.dirname(ipa_path))
    build_options = {
      scheme: scheme,
      clean: true,
      export_method: "app-store",
      output_directory: File.dirname(ipa_path),
      output_name: File.basename(ipa_path),
      skip_package_ipa: false
    }
    if xcode_workspace.empty?
      build_options[:project] = xcode_project
    else
      build_options[:workspace] = xcode_workspace
    end

    build_app(build_options)
    
    UI.user_error!("IPA not found at #{ipa_path}. Make sure the file exists before running this lane.") unless File.exist?(ipa_path)
    
    api_key = app_store_connect_api_key_from_env
    
    upload_to_testflight(
      ipa: ipa_path,
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
    
    UI.success("Uploaded #{ipa_path} to TestFlight.")
  end
end
