default_platform(:ios)

platform :ios do
  desc "Compile the iOS app and upload it to TestFlight directly"
  lane :deploy do
    team_id = ENV["FASTLANE_TEAM_ID"].to_s.strip
    UI.user_error!("Missing FASTLANE_TEAM_ID secret.") if team_id.empty?

    # Fastlane tools will automatically pull from global environment variables
    get_certificates
    get_provisioning_profile(app_identifier: "://packpulsedrops.com")
    
    build_app(
      scheme: "App",
      configuration: "Release",
      project: "ios/App/App.xcodeproj",
      export_method: "app-store",
      export_team_id: team_id,
      xcargs: "DEVELOPMENT_TEAM=#{team_id}"
    )
    
    upload_to_testflight(skip_waiting_for_build_processing: true)
    UI.success("Successfully uploaded app to TestFlight!")
  end
end
