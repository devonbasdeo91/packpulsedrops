default_platform(:ios)

platform :ios do
  desc "Compile the iOS app and upload it to TestFlight directly"
  lane :deploy do
    team_id = ENV["FASTLANE_TEAM_ID"].to_s.strip
    UI.user_error!("Missing FASTLANE_TEAM_ID secret.") if team_id.empty?

    # Force format reconstruction to ensure newlines are preserved precisely for Apple's server
    raw_key = ENV["FASTLANE_API_KEY_KEY_CONTENT"].to_s
    formatted_key = raw_key.include?("BEGIN PRIVATE KEY") ? raw_key : raw_key.gsub("\\n", "\n")

    # Load the App Store Connect API key configuration
    api_key = app_store_connect_api_key(
      key_id: ENV["FASTLANE_API_KEY_KEY_ID"],
      issuer_id: ENV["FASTLANE_API_KEY_ISSUER_ID"],
      key_content: formatted_key,
      is_key_content_base64: false
    )

    # Use force: false for certificates, and readonly: true for provisioning profiles
    get_certificates(api_key: api_key, force: false)
    get_provisioning_profile(api_key: api_key, app_identifier: "com.pack-pulse-drops.pack-pulse-drops", readonly: true)
    
    build_app(
      scheme: "App",
      configuration: "Release",
      project: "ios/App/App.xcodeproj",
      export_method: "app-store",
      export_team_id: team_id,
      xcargs: "DEVELOPMENT_TEAM=#{team_id}"
    )
    
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
    UI.success("Successfully uploaded app to TestFlight!")
  end
end
