default_platform(:ios)

platform :ios do
  # Upload via App Store Connect API key (.p8)
  # Requires: ASC_KEY_ID, ASC_ISSUER_ID, ASC_PRIVATE_KEY (base64 .p8 content)
  desc "Upload IPA to TestFlight using App Store Connect API key"
  lane :upload_to_testflight do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_PRIVATE_KEY"],
      is_key_content_base64: true,
      in_house: false
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: ENV["IPA_PATH"] || "build/app.ipa",
      skip_waiting_for_build_processing: true
    )
  end

  # Upload via distribution certificate (.p12) + Apple ID
  # Requires: APPLE_ID, APPLE_ID_PASSWORD (app-specific password), APP_IDENTIFIER, TEAM_ID
  # Certificate must already be imported into the keychain by the workflow before this lane runs
  desc "Upload IPA to TestFlight using distribution certificate and Apple ID"
  lane :upload_p12 do
    upload_to_testflight(
      username: ENV["APPLE_ID"],
      app_identifier: ENV["APP_IDENTIFIER"],
      team_id: ENV["TEAM_ID"],
      ipa: ENV["IPA_PATH"] || "build/app.ipa",
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload IPA directly to App Store Connect for review (API key)"
  lane :upload_to_appstore do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_PRIVATE_KEY"],
      is_key_content_base64: true,
      in_house: false
    )

    deliver(
      api_key: api_key,
      ipa: ENV["IPA_PATH"] || "build/app.ipa",
      submit_for_review: false,
      automatic_release: false,
      skip_metadata: true,
      skip_screenshots: true,
      force: true
    )
  end
end
