def preferred_xcode_paths(workspace_root, extension)
  exclude_nested_workspace_paths = extension == "xcworkspace"
  Dir.glob(File.join(workspace_root, "**/*.#{extension}"))
     .reject do |path|
       components = Pathname.new(path).each_filename.to_a
       in_pods_path = components.include?("Pods") || File.basename(path).start_with?("Pods.")
       nested_workspace_path = exclude_nested_workspace_paths && path.include?(".xcodeproj/")
       in_pods_path || nested_workspace_path
     end
     .sort_by { |path| [path.count("/"), path] }
end

