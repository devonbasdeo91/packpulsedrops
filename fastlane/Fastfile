default_platform(:ios)

platform :ios do
  desc "Compile the iOS app and upload it to TestFlight directly"
  lane :deploy do
    team_id = ENV["FASTLANE_TEAM_ID"].to_s.strip
    UI.user_error!("Missing FASTLANE_TEAM_ID secret.") if team_id.empty?

    # Explicitly load the API Key using the native environment variables mapped in your workflow
    api_key = app_store_connect_api_key(
      key_id: ENV["FASTLANE_API_KEY_KEY_ID"],
      issuer_id: ENV["FASTLANE_API_KEY_ISSUER_ID"],
      key_content: ENV["FASTLANE_API_KEY_KEY_CONTENT"],
      is_key_content_base64: false
    )

    # Pass the authenticated api_key down to bypass the username requirement
    get_certificates(api_key: api_key)
    get_provisioning_profile(api_key: api_key, app_identifier: "app.packpulsedrops.com")
    
    build_app(
      scheme: "App",
      configuration: "Release",
      project: "ios/App/App.xcodeproj",
      export_method: "app-store",
      export_team_id: team_id,
      xcargs: "DEVELOPMENT_TEAM=#{team_id}"
    )
    
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
    UI.success("Successfully uploaded app to TestFlight!")
  end
end
