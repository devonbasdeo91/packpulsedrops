
























efault_platform(:ios)

platform :ios do
  desc "Compile the iOS app and upload it to TestFlight directly"
  lane :deploy do
    team_id = ENV["FASTLANE_TEAM_ID"].to_s.strip
    UI.user_error!("Missing FASTLANE_TEAM_ID secret.") if team_id.empty?

    # Direct Xcode distribution compilation utilizing automated system overrides
    build_app(
      scheme: "App",
      project: "ios/App/App.xcodeproj",
      export_method: "app-store",
      export_team_id: team_id,
      xcargs: "DEVELOPMENT_TEAM=#{team_id} CODE_SIGN_IDENTITY='iPhone Distribution' CODE_SIGNING_REQUIRED=NO CODE_SIGNING_ALLOWED=NO"
    )

    # Directly stream the package payload up utilizing user credentials
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
    UI.success("Successfully uploaded app to TestFlight!")
  end
end
