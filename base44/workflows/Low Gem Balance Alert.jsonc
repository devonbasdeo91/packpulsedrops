{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "low_gem_alert",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "check_balances": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "check-low-gem-balances",
            "args": {
              "internal_secret": "wf_caller"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Check low gem balances",
            "description": "Email users below 50 gems"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 6,
      "interval_unit": "hours",
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Checks all users' gem balances every 6 hours and emails those below 50 gems via Gmail, reminding them to top up their account.",
  "name": "Low Gem Balance Alert"
}