{
  "description": "Sends a monthly email summary of all card sales and withdrawal activity to the app owner via Gmail on the 1st of each month at 9am ET.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 1 * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Monthly Sales Report",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "monthly_sales_report",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_report": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "send-monthly-sales-report",
            "args": {
              "internal_secret": "wf_caller"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send monthly report",
            "description": "Email sales + withdrawal summary"
          }
        }
      }
    ]
  }
}