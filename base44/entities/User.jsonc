{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "username": {
      "type": "string",
      "description": "Unique display username chosen by the user at registration (lowercase, 3-20 chars)"
    },
    "gems": {
      "type": "integer",
      "default": 0,
      "description": "Wallet balance in gems (1 gem = $0.0035). Credited by deposits, daily rewards, and marketplace sales; debited by purchases and withdrawals."
    },
    "last_free_pack": {
      "type": "string",
      "description": "Date string (YYYY-MM-DD) of the last free pack claim; used to enforce one free pack per day"
    },
    "referral_credits": {
      "type": "integer",
      "default": 0,
      "description": "Credits earned from referral sign-ups"
    },
    "referred_by": {
      "type": "string",
      "description": "User id of the referrer who invited this user"
    },
    "pack_credits": {
      "type": "integer",
      "default": 0,
      "description": "Generic pack credits available to rip"
    },
    "streak": {
      "type": "integer",
      "default": 0,
      "description": "Current consecutive activity streak"
    },
    "last_daily_reward": {
      "type": "string",
      "description": "Date string (YYYY-MM-DD) of the last daily reward claim; used to enforce one daily reward per day"
    },
    "daily_reward_streak": {
      "type": "integer",
      "default": 0,
      "description": "Current consecutive daily reward claim streak"
    },
    "autopost_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether rare pulls are automatically posted to the user's connected social page"
    },
    "autopost_page_id": {
      "type": "string",
      "description": "The Facebook Page ID selected for auto-posting rare pulls"
    },
    "autopost_page_name": {
      "type": "string",
      "description": "Display name of the Facebook Page selected for auto-posting"
    },
    "last_vault_summary": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last daily vault digest email sent to this user"
    },
    "welcome_pack_claimed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user claimed their one-time welcome free pack"
    },
    "purchased_packs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Pack IDs bought with cash and pending redemption (pack-specific credits)"
    },
    "purchased_cards": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Card IDs bought directly with cash and pending delivery to the vault"
    },
    "low_gem_notified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last low-gem-balance reminder email sent to this user"
    },
    "sheets_log_id": {
      "type": "string",
      "description": "Google Sheets spreadsheet ID where the user's pack openings and card pulls are logged"
    },
    "stripe_account_id": {
      "type": "string",
      "description": "Stripe Express account ID for marketplace payouts and withdrawals"
    },
    "first_trade_bonus_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the user's first-trade referral milestone bonus was granted (idempotency guard for the First Trade Referral workflow)"
    },
    "challenge_incentive_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Deadline for the guest-purchase challenge incentive bonus. When set and in the future, the user receives bonus gems on their first DailyChallenge claim. Set by the Guest Challenge Incentive workflow; cleared after the bonus is granted or when it expires."
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object",
  "rls": {
    "read": {
      "$or": [
        {
          "data.id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}