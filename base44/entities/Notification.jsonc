{
  "name": "Notification",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "withdrawal_pending",
        "withdrawal_paid",
        "withdrawal_rejected",
        "trade_accepted",
        "trade_declined",
        "trade_request",
        "info"
      ]
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string",
      "maxLength": 500
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "link": {
      "type": "string"
    },
    "metadata": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "type",
    "title",
    "message"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}