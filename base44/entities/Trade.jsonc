{
  "name": "Trade",
  "type": "object",
  "properties": {
    "requester_id": {
      "type": "string"
    },
    "requester_name": {
      "type": "string"
    },
    "recipient_id": {
      "type": "string"
    },
    "recipient_name": {
      "type": "string"
    },
    "offered_pull_id": {
      "type": "string"
    },
    "offered_card_name": {
      "type": "string"
    },
    "offered_category": {
      "type": "string"
    },
    "offered_rarity": {
      "type": "string"
    },
    "offered_value_gems": {
      "type": "integer",
      "default": 0
    },
    "offered_image_url": {
      "type": "string"
    },
    "requested_pull_id": {
      "type": "string"
    },
    "requested_listing_id": {
      "type": "string",
      "description": "Set when the trade targets a marketplace listing instead of a friend's pull"
    },
    "requested_card_name": {
      "type": "string"
    },
    "requested_category": {
      "type": "string"
    },
    "requested_rarity": {
      "type": "string"
    },
    "requested_value_gems": {
      "type": "integer",
      "default": 0
    },
    "requested_image_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ],
      "default": "pending"
    }
  },
  "required": [
    "requester_id",
    "recipient_id",
    "offered_pull_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.requester_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.requester_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.requester_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}